<Window x:Class="ReaderPro.Views.BatchManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量管理书本" Width="720" Height="600"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="全选" Padding="10,4" Margin="0,0,6,0" Click="SelectAll_Click"/>
            <Button Content="全不选" Padding="10,4" Margin="0,0,16,0" Click="SelectNone_Click"/>
            <Button Content="批量删除" Padding="10,4" Margin="0,0,6,0" Click="BatchDelete_Click"/>
            <TextBlock Text="加标签：" VerticalAlignment="Center" Margin="16,0,4,0"/>
            <TextBox x:Name="TagBox" Width="140" VerticalContentAlignment="Center"/>
            <Button Content="应用标签" Padding="10,4" Margin="6,0,0,0" Click="BatchTag_Click"/>
        </StackPanel>

        <!-- 书本列表 -->
        <DataGrid Grid.Row="1" x:Name="Grid" AutoGenerateColumns="False"
                  HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single"
                  RowHeaderWidth="0" GridLinesVisibility="Horizontal" IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Width="32" Binding="{Binding Chk}"/>
                <DataGridTextColumn Header="书名" Binding="{Binding Title}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="作者" Binding="{Binding Author}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="标签" Binding="{Binding TagsText}" Width="160" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,16,0" Opacity="0.6"/>
            <Button Content="关闭" Padding="24,6" Click="Close_Click" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
