<Window x:Class="ReaderPro.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ReaderPro.ViewModels"
        xmlns:local="clr-namespace:ReaderPro"
        Title="设置 · 系统服务中心" Width="560" Height="560"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 阅读 -->
                <GroupBox Header="阅读" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="字号" Width="80" VerticalAlignment="Center"/>
                            <Slider Width="260" Minimum="12" Maximum="48" Value="{Binding FontSize}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FontSize, StringFormat={}{0:F0} pt}" Width="50" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="主题" Width="80" VerticalAlignment="Center"/>
                            <ComboBox Width="260" ItemsSource="{Binding ThemeNames}" SelectedItem="{Binding ThemeName}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="书架列数" Width="80" VerticalAlignment="Center"/>
                            <ComboBox Width="260" ItemsSource="{Binding ShelfColumnsOptions}" SelectedItem="{Binding ShelfColumns}"
                                      ToolTip="1-2列右侧显示简介，3列及以上紧凑排列"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- 听书 -->
                <GroupBox Header="听书（离线语音）" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="语音" Width="80" VerticalAlignment="Center"/>
                            <ComboBox Width="260" ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}"
                                      ToolTip="Windows 已安装的离线语音包"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="语速" Width="80" VerticalAlignment="Center"/>
                            <Slider Width="260" Minimum="-5" Maximum="5" Value="0" IsSnapToTickEnabled="True"
                                    ValueChanged="Rate_Changed" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="音量" Width="80" VerticalAlignment="Center"/>
                            <Slider Width="260" Minimum="0" Maximum="100" Value="{Binding Volume}"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- 关于 -->
                                <!-- 联网补全 -->
                <GroupBox Header="联网补全（元数据）" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="HTTP 代理" Width="80" VerticalAlignment="Center"/>
                            <TextBox Width="280" Text="{Binding MetadataProxy}" VerticalAlignment="Center"
                                     ToolTip="填了代理后，智能整理走 Google Books / Open Library 拿完整简介；留空=直连必应"/>
                        </StackPanel>
                        <TextBlock Text="例：http://127.0.0.1:7890。留空则仅用必应摘要。" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

<GroupBox Header="关于" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="版本" Width="80" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AppVersion}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="数据目录" Width="80" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DataDir}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                            <Button Content="打开" Padding="8,2" Margin="8,0,0,0" Click="OpenDataDir_Click"/>
                        </StackPanel>
                        <TextBlock Text="所有设置与书库数据均保存在数据目录，随程序文件夹迁移。" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1" Content="关闭" Padding="24,6" HorizontalAlignment="Right" Click="Close_Click" FontWeight="SemiBold"/>
    </Grid>
</Window>
