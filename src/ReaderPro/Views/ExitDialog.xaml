<Window x:Class="ReaderPro.Views.ExitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="退出 ReaderPro" Width="420" Height="260"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="要直接退出 ReaderPro，还是最小化到托盘后台运行？" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1">
            <RadioButton x:Name="RadioTray" Content="最小化到托盘（后台运行，随时双击托盘图标唤起）" IsChecked="True" Margin="0,0,0,8"/>
            <RadioButton x:Name="RadioExit" Content="直接退出程序" Margin="0,0,0,8"/>
            <CheckBox x:Name="Remember" Content="记住我的选择（以后不再询问）" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Padding="18,5" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="取消" Padding="18,5" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
