<Window x:Class="ReaderPro.Views.OrganizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ReaderPro.ViewModels"
        xmlns:local="clr-namespace:ReaderPro"
        Title="智能整理 · 元数据修正" Width="960" Height="640"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVis"/>
        <local:NullToVisibilityInverseConverter x:Key="NullToVisInverse"/>
        <local:InverseBoolConverter x:Key="InverseBool"/>
        <local:NullToBoolConverter x:Key="NullToBool"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：状态 + 操作 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center" Opacity="0.7"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="开始联网比对" Padding="12,5" Margin="0,0,8,0" Click="Compare_Click" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                <Button Content="全部采纳" Padding="12,5" Margin="0,0,8,0" Click="AcceptAll_Click"/>
                <Button Content="保存并关闭" Padding="12,5" Click="Save_Click" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <!-- 待确认列表 -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Items}" BorderThickness="1" BorderBrush="#22000000"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#0A000000" CornerRadius="6" Margin="2,3" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 封面/占位 -->
                            <Border Grid.Column="0" Width="54" Height="72" CornerRadius="3" Background="#334E71" Margin="0,0,10,0">
                                <Grid>
                                    <Image Source="{Binding Cover}" Stretch="UniformToFill"
                                           Visibility="{Binding Cover, Converter={StaticResource NullToVisInverse}}"/>
                                    <TextBlock Text="{Binding OriginalTitle}" TextWrapping="Wrap" Foreground="White"
                                               FontSize="11" TextAlignment="Center" Margin="3" VerticalAlignment="Center"
                                               Visibility="{Binding Cover, Converter={StaticResource NullToVis}}"/>
                                </Grid>
                            </Border>

                            <!-- 信息：原书名 → 建议 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="12" Opacity="0.55">
                                    <Run Text="原："/><Run Text="{Binding OriginalTitle}"/>
                                    <Run Text="　"/><Run Text="{Binding SuspectReasons, Mode=OneWay}" Foreground="#D47706"/>
                                </TextBlock>
                                <TextBlock Margin="0,4,0,0" FontSize="15" FontWeight="SemiBold">
                                    <Run Text="建议："/><Run Text="{Binding SuggestedTitle, Mode=OneWay}" Foreground="#2F6FED"/>
                                    <Run Text="{Binding SuggestedAuthor, Mode=OneWay, StringFormat='（{0}）'}" Foreground="#8899AA"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Intro}" Margin="0,3,0,0" Opacity="0.6" FontSize="12"
                                           TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                                <TextBlock Margin="0,3,0,0" FontSize="11" Opacity="0.4" Text="{Binding Source, StringFormat='来源：{0}'}"/>
                            </StackPanel>

                            <!-- 操作 -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="150">
                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="采纳" Padding="10,3" Margin="0,0,6,0"
                                            IsEnabled="{Binding Candidate, Converter={StaticResource NullToBool}}"
                                            Click="Accept_Click"/>
                                    <Button Content="忽略" Padding="10,3" Click="Ignore_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" Margin="0,8,0,0" FontSize="11" Opacity="0.45"
                   Text="提示：本地置信度分析无需联网；「开始联网比对」会查询豆瓣/知轩藏书/必应（各源独立容错）。采纳后落库书名、作者、简介与封面。"/>
    </Grid>
</Window>
